              }
            }
          }
        }
      }
    }
  },
  "request_timeout_seconds": {
    "type": "int",
    "description": "渠道读取超时（秒）",
    "default": 30,
    "hint": "转述模型的单个请求超时为此值的三倍。"
  },
  "max_history_results": {
    "type": "int",
    "description": "历史发言工具最大返回条数",
    "default": 100
  },
  "max_history_pages": {
    "type": "int",
    "description": "历史发言工具每次最多扫描页数，每页 100 条",
    "default": 10
  }
}
