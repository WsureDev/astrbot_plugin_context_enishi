        }
      }
    }
  },
  "request_timeout_seconds": {
    "type": "int",
    "description": "渠道读取超时（秒）",
    "default": 30,
    "hint": "转述模型的单个请求超时为此值的三倍。"
  },
  "max_history_results": {
    "type": "int",
    "description": "历史发言工具最大返回条数",
    "default": 100
  },
  "max_history_pages": {
    "type": "int",
    "description": "历史发言工具每次最多扫描页数，每页 100 条",
    "default": 10
  },
  "group_flow": {
    "type": "object",
    "description": "群聊流水",
    "hint": "在渠道条目的上下文整理中启用。日志与转述缓存分开；最终会话仍由 AstrBot 保存。",
    "items": {
      "max_log_records": {
        "type": "int",
        "description": "每个会话保留的最大原始消息数",
        "default": 5000,
        "hint": "0 表示不限制。裁剪不重置消息顺序号。"
      },
      "max_delta_messages": {
        "type": "int",
        "description": "每轮最多注入的增量消息数",
        "default": 0,
        "hint": "0 表示不限制。超过预算时跳过较早消息，并在 META 报告数量。"
      },
      "max_delta_chars": {
        "type": "int",
        "description": "每轮增量最多字符数",
        "default": 16000,
        "hint": "0 表示不限制；非零最少 512。跳过的消息在本轮保存后不会自动补发。"
      },
      "record_self_messages": {
        "type": "bool",
        "description": "记录机器人非 LLM 平台消息",
        "default": false,
        "hint": "LLM 回复的近期平台回流单独过滤，避免和 assistant 历史重复。"
      },
      "record_empty_messages": {
        "type": "bool",
        "description": "记录无正文消息",
        "default": true,
        "hint": "图片等非文本消息保留原生定位或组件标记。"
      }
    }
  },
  "history_budget": {
    "type": "object",
    "description": "历史上下文范围",
    "hint": "独立于图片模式、群聊流水和工具收纳。按字符控制旧上下文，直接移除最老完整轮次，不额外调用模型；不截断当前任务，不限制 Monitor 存档。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用历史字数控制",
        "default": true
      },
      "max_chars": {
        "type": "int",
        "description": "历史上限（字符）",
        "default": 60000,
        "hint": "旧消息按 JSON 字符数计量，含工具结果和调用参数；不含系统提示、工具定义和当前任务。超过上限后按整轮收缩。"
      },
      "target_chars": {
        "type": "int",
        "description": "收缩后的目标（字符）",
        "default": 40000,
        "hint": "保留最近完整轮次，尽量收缩到目标附近。已落在目标与上限之间时，不为凑字数再丢整轮。目标必须大于 0 且不高于历史上限，不会隐藏改写你填写的数值。"
      },
      "max_group_chars": {
        "type": "int",
        "description": "群聊流水总预算（字符）",
        "default": 12000,
        "hint": "限制新旧群聊增量块合计，优先保留最近完整消息行；0 不单独限制流水。当前用户消息和完整原生图片 ID 不做字符截断。"
      }
    }
  },
  "capabilities": {
    "type": "object",
    "description": "工具与 Skill 收纳",
    "hint": "独立于渠道图片和群聊流水。详细组策略在插件页面「工具与 Skill 管理」设置；启用前关闭 Lazy Tools 的工具和 Skills 变换。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用工具与 Skill 管理",
        "default": false
      },
      "new_group_mode": {
        "type": "string",
        "description": "新增组的默认策略",
        "default": "folded",
        "options": [
          "folded",
          "primary"
        ],
        "labels": [
          "收纳，可发现和加载",
          "一级常驻，始终显示完整定义"
        ],
        "hint": "仅作用于首次发现的组。已有组新增工具继承原组策略。"
      },
      "idle_rounds": {
        "type": "int",
        "description": "连续未使用多少轮后收起",
        "default": 5,
        "hint": "一次用户请求及其完整工具链算一轮。工具内部步骤、重试、闲聊不计；可在管理页按组覆盖。"
      },
      "mcp_poll_seconds": {
        "type": "int",
        "description": "MCP 工具列表兜底刷新间隔（秒）",
        "default": 60,
        "hint": "通知触发实时刷新；0 关闭定期远程拉取，仍会核对本地目录。"
      },
      "fold_skills": {
        "type": "bool",
        "description": "折叠 Skill 目录和已加载正文",
        "default": true,
        "hint": "只处理原生 Skill 构建入口；完整正文按需读取和恢复，不截断说明或改写其他提示词。"
      },
      "archive_results": {
        "type": "bool",
        "description": "闲置工具结果收纳为可恢复引用",
        "default": true,
        "hint": "当前任务保留完整文本结果；收起后保留调用配对和完整存档。图片仍沿用原生 ID 和图片策略。"
      }
    }
  }
}
